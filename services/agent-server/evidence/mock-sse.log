data: {"type":"file","path":"/src/App.tsx","content":"import { useState } from 'react';\nimport { Button, TextField, Table } from '@toi/tds';\nimport { listRecords, getRecord } from './api';\nexport default function App() {\n  const [reason, setReason] = useState(\"고객 문의 확인\");\n  const [rows, setRows] = useState<Record<string, unknown>[]>([]);\n  const [customerId, setCustomerId] = useState('1');\n  const [error, setError] = useState('');\n  async function load() {\n    if (reason.trim().length < 5) { setError('조회 사유를 5자 이상 입력하세요.'); return; }\n    try { const data = await listRecords(reason); setRows(data.items ?? [data]); setError(''); } catch { setError('조회 권한과 연결 상태를 확인하세요.'); }\n  }\n  return <main><h1>고객 목록</h1><TextField label=\"조회 사유\" value={reason} onChange={e => setReason(e.target.value)} />\n    <Button onClick={load}>조회</Button><p role=\"alert\">{error}</p>\n    \n    \n    <Table columns={[{key:'id',header:'ID'},{key:'name',header:'이름'},{key:'status',header:'상태'}]} rows={rows} rowKey=\"id\" /></main>;\n}\n","generationId":"8526fe06-b83a-45ed-a571-b291952d4ba6","seq":8}

