AGENT_MODE=auto
# Exact browser origin allowed to read projects/events and submit JSON mutations.
# Requests without Origin (server-to-server) are also allowed.
AGENT_STUDIO_ORIGIN=http://localhost:5173
# Set only for real Claude API calls. SDK ANTHROPIC_AUTH_TOKEN/profile credentials also work.
# ANTHROPIC_API_KEY=
POLICY_PROXY_URL=http://localhost:7200
# Optional pre-issued service session. Otherwise local /dev/session is used.
# POLICY_SESSION_TOKEN=
DATA_DIR=data
