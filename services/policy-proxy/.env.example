# Development only: use node scripts/dev-up.mjs at the repository root to generate shared random keys.
# Production MUST set all three secrets to independent values of at least 32 bytes.
TOI_UPSTREAM_SERVICE_TOKEN=
TOI_SESSION_SECRET=
TOI_CAPABILITY_SECRET=
TOI_CUSTOMERS_UPSTREAM=http://localhost:7300
TOI_UPSTREAM_ALLOWLIST=http://localhost:7300
# DEV ONLY. Production refuses to start unless this is explicitly false.
TOI_DEV_AUTH_ENABLED=true
# Server-only privileged dev bootstrap; MUST be unset (not even empty) in production.
# TOI_DEV_ADMIN_TOKEN=
TOI_POLICY_DATA_DIR=
