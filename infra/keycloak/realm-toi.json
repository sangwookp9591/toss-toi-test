{
  "realm": "toi",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "builder"
      },
      {
        "name": "api-owner"
      },
      {
        "name": "platform-admin"
      }
    ]
  },
  "groups": [
    {
      "name": "team-a"
    },
    {
      "name": "team-b"
    },
    {
      "name": "risk"
    },
    {
      "name": "platform"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@toi.local",
      "firstName": "alice",
      "lastName": "TOI",
      "groups": [
        "/team-a"
      ],
      "realmRoles": [
        "builder"
      ],
      "requiredActions": []
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@toi.local",
      "firstName": "bob",
      "lastName": "TOI",
      "groups": [
        "/team-a"
      ],
      "realmRoles": [
        "builder"
      ],
      "requiredActions": []
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@toi.local",
      "firstName": "carol",
      "lastName": "TOI",
      "groups": [
        "/team-b"
      ],
      "realmRoles": [
        "builder"
      ],
      "requiredActions": []
    },
    {
      "username": "dana",
      "enabled": true,
      "emailVerified": true,
      "email": "dana@toi.local",
      "firstName": "dana",
      "lastName": "TOI",
      "groups": [
        "/risk"
      ],
      "realmRoles": [
        "api-owner"
      ],
      "requiredActions": []
    },
    {
      "username": "root",
      "enabled": true,
      "emailVerified": true,
      "email": "root@toi.local",
      "firstName": "root",
      "lastName": "TOI",
      "groups": [
        "/platform"
      ],
      "realmRoles": [
        "platform-admin"
      ],
      "requiredActions": []
    }
  ],
  "clients": [
    {
      "clientId": "toi-studio",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "toi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "toi-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "toi-agent-server",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "toi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "toi-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "toi-policy-proxy",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "toi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "toi-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
