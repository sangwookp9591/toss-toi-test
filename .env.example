# infra
MINIO_ROOT_USER=toi
MINIO_ROOT_PASSWORD=toi-local-secret
# deps-builder: Verdaccio 토큰은 빌드 워커 프로세스만 읽는다
TOI_REGISTRY_URL=http://localhost:4873
TOI_REGISTRY_TOKEN=
# policy-proxy
TOI_SESSION_SECRET=dev-session-secret-change-me
TOI_CAPABILITY_SECRET=dev-capability-secret-change-me
# agent-server: 비우면 SDK 기본 자격증명 해석 → 실패 시 mock
ANTHROPIC_API_KEY=
AGENT_MODE=auto
