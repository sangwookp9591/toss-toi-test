# infra
MINIO_ROOT_USER=toi
MINIO_ROOT_PASSWORD=toi-local-secret
# deps-builder: Verdaccio 토큰은 빌드 워커 프로세스만 읽는다
TOI_REGISTRY_URL=http://localhost:4873
TOI_REGISTRY_TOKEN=
# policy-proxy
# Development: dev-up generates and saves random keys in ignored .env.
# Production: set all three to independent secrets >=32 bytes and disable dev auth.
TOI_SESSION_SECRET=
TOI_CAPABILITY_SECRET=
TOI_UPSTREAM_SERVICE_TOKEN=
# DEV ONLY: production requires false.
TOI_DEV_AUTH_ENABLED=true
# Dev-only privileged bootstrap token; leave unset in production.
# TOI_DEV_ADMIN_TOKEN=
# agent-server: 비우면 SDK 기본 자격증명 해석 → 실패 시 mock
ANTHROPIC_API_KEY=
AGENT_MODE=auto
