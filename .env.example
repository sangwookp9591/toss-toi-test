# infra
MINIO_ROOT_USER=toi
MINIO_ROOT_PASSWORD=toi-local-secret
# deps-builder: Verdaccio 토큰은 빌드 워커 프로세스만 읽는다
TOI_REGISTRY_URL=http://localhost:4873
TOI_REGISTRY_TOKEN=
# Identity and environment credentials: dev-up writes random values into ignored .env (0600).
TOI_IDENTITY_ISSUER=http://localhost:8080/realms/toi
TOI_SESSION_SECRET=
TOI_CAPABILITY_SECRET=
TOI_PREVIEW_SERVICE_TOKEN=
TOI_LIVE_SERVICE_TOKEN=
TOI_AGENT_CLIENT_SECRET=
TOI_POLICY_CLIENT_SECRET=
TOI_KEYCLOAK_ADMIN_PASSWORD=
TOI_PASSWORD_ALICE=
TOI_PASSWORD_BOB=
TOI_PASSWORD_CAROL=
TOI_PASSWORD_DANA=
TOI_PASSWORD_ROOT=
# User UUIDs TOI_SUB_* are written by dev-up after Keycloak provisioning.
# Shorten only when testing expiration; default 300 seconds.
# TOI_APPROVAL_TTL_SEC=300
# No development session endpoint exists.
# agent-server: 비우면 SDK 기본 자격증명 해석 → 실패 시 mock
ANTHROPIC_API_KEY=
AGENT_MODE=auto
# Download encryption and isolated policy storage credentials: generated by dev-up.
TOI_DOWNLOAD_KEK=
TOI_DOWNLOAD_KEK_ID=
TOI_DOWNLOAD_URL_SECRET=
TOI_DOWNLOAD_BUCKET=toi-downloads
TOI_AUDIT_BUCKET=toi-audit
TOI_POLICY_MINIO_USER=toi-policy
TOI_POLICY_MINIO_PASSWORD=
# Runtime children set TOI_MANAGED_ENV=1 and receive service-specific env allowlists.
# TOI_ENABLE_BENCH=true enables studio benchmark routes, never preview routes.

# Audit object-lock retention (development default: 1 day)
TOI_AUDIT_RETENTION_DAYS=1
